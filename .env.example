GEMINI_API_KEY="your-gemini-key-here"
# Optional: Groq API Key as a fallback
GROQ_API_KEY="your-groq-key-here"
GITHUB_TOKEN="your-github-token-here"
GITHUB_REPO="your-username/repo-name"

# Base directory for cvs, docs, and applications
CVS_DIR="cvs"

# LibreOffice binary path for PDF conversion
# Mac default: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Windows default: "C:\Program Files\LibreOffice\program\soffice.exe"
SOFFICE_PATH="/Applications/LibreOffice.app/Contents/MacOS/soffice"

# Search Configuration
SEARCH_KEYWORDS="Software Engineer, Backend Developer"
SEARCH_LOCATIONS="New York, Remote"

# User Configuration
CANDIDATE_NAME="Jane Doe"

# Template File Names (expected to be inside CVS_DIR/docs/)
CV_TEMPLATE_NAME="Base_CV_Template.docx"
CL_TEMPLATE_NAME="Base_CL_Template.docx"
DOSSIER_NAME="Career_Dossier.md"

# Minimum AI evaluation score required to push a job to the Kanban board
MIN_PASS_SCORE=9

# Email Notification Settings
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="your-email@example.com"
SMTP_TO="your-email@example.com"