<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.jobscraper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/home/Work/jobscraper/venv/bin/python</string>
        <string>main.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/home/Work/jobscraper</string>

    <key>StandardOutPath</key>
    <string>/path/to/home/Work/jobscraper/cron.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/home/Work/jobscraper/cron.log</string>

    <!-- Nightly at 03:00. If the Mac is asleep, launchd runs it once it wakes. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- The scraper drives a visible Chromium, so it needs the GUI session. -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
