# ---------------------------------------------------------------------------
# Mode - read DISCLAIMER.md
# ---------------------------------------------------------------------------
# full: scrapes and applies through a browser signed in to your LinkedIn
#       account. LinkedIn prohibits this; the account can be restricted or banned.
# safe: never automates your logged-in account. New jobs come from the job-alert
#       emails LinkedIn sends you (IMAP settings below). Anything that is not a
#       recognised value is treated as safe.
JOBSCRAPER_MODE="full"

# LinkedIn's job-alert emails are read from this mailbox. Mail is never moved
# or deleted. Use an app password, not your real one.
IMAP_HOST="imap.gmail.com"
IMAP_USER="you@example.com"
IMAP_PASSWORD=""
# The folder (a Gmail label is a folder) the job-alert emails are in - e.g. a
# label a filter files them under, skipping the inbox.
IMAP_FOLDER="INBOX"
# true: mark each job-alert email read once its jobs are stored. Nothing is ever
# moved or deleted, and application-status emails are always left unread.
IMAP_MARK_READ=false
# How far back the first run looks; later runs continue from the last email read.
ALERT_LOOKBACK_DAYS=14
# Descriptions are read from public job pages in a throwaway browser with no
# cookies (and from Adzuna's advert pages over plain HTTP; the same limits
# apply). At most this many per run; a job that fails this many times is
# reported instead of retried. If LinkedIn walls the fetcher, the run stops and
# tries again next time - there is no proxying or evasion.
SAFE_FETCH_MAX_PER_RUN=60
SAFE_FETCH_MAX_ATTEMPTS=3
# Days a job may wait for its description before it goes to Rejected unscored.
SAFE_FETCH_MAX_AGE_DAYS=14

# ---------------------------------------------------------------------------
# Adzuna - a second source of jobs, in either mode
# ---------------------------------------------------------------------------
# Adzuna's official job-search API (free key: https://developer.adzuna.com).
# It runs the searches in search_criteria.md and never touches LinkedIn. Leave
# the id empty to switch it off. Limits: 25 calls a minute, 250 a day.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# Country searched around a city named in Search Locations, as Adzuna's
# two-letter code (ch, de, gb...); empty = HOME_COUNTRY's. A country name
# ("Switzerland", "Germany") is mapped by adzuna.py instead.
ADZUNA_COUNTRY=""
# Countries searched for "Worldwide", "Europe" or "Remote" - each one costs a
# call per keyword. Empty skips those locations.
ADZUNA_WIDE_COUNTRIES=""
# Adverts posted in the last this-many days (the first run looks back 14).
ADZUNA_MAX_DAYS_OLD=3
# Pages of 50 per search, and a hard cap on calls per run.
ADZUNA_MAX_PAGES=2
ADZUNA_MAX_CALLS_PER_RUN=40
# Full descriptions are read from Adzuna's advert pages, 5-10 s apart, at most
# this many a run.
ADZUNA_FETCH_MAX_PER_RUN=60

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Infomaniak AI Services is tried first when configured - Swiss-hosted, and the
# default cascade leads with gemma, which follows the hard rules in rules.md
# more faithfully than the alternatives. Token needs the "ai-tools" scope;
# product id comes from GET https://api.infomaniak.com/1/ai
# Leave INFOMANIAK_MODELS empty to use the cascade in infomaniak.py; run
# "python infomaniak.py" to list the model ids this account can use.
INFOMANIAK_API_TOKEN=""
INFOMANIAK_PRODUCT_ID=""
INFOMANIAK_MODELS=""

# Fallbacks, used only when Infomaniak is unset or every model there fails.
# Any one of the three providers is enough to run.
GEMINI_API_KEY="your-gemini-key-here"
GROQ_API_KEY="your-groq-key-here"

# ---------------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------------
# At or above this score a job lands on the To Do board, and the evaluator is
# asked for salary, recruiter flag, hiring manager and language. Read in one
# place (db.min_pass_score) and injected into the prompt, so the board
# threshold and the prompt cannot drift apart.
MIN_PASS_SCORE=7

# Hard location rules. The scorer reports each job's work arrangement, country
# and region, and the code - not the model, which applies such rules
# unreliably - caps a job that breaks them at 2 ("Location mismatch").
# Where you live, by its common English name (Switzerland, Germany, United
# States...). On-site and hybrid jobs anywhere in it pass; empty = no rule.
# It also sets the defaults that depend on a country (locales.py): letter
# conventions where the job's country is unknown, the languages listed first
# on the dashboard, the phone dialling code, the company names dropped when
# matching duplicates, Adzuna's country.
HOME_COUNTRY=""
# What "region" means there, as the scorer should report it - the codes below
# must be in this form. E.g. "canton, as its two-letter code (VD, GE, ZH, ...)",
# "state, as its two-letter code (CA, NY, ...)", "department, as its number
# (75, 69, ...)". Empty = first-level region, usual short code.
REGION_TYPE=""
# On-site jobs only in these regions (comma-separated codes); empty = anywhere
# in HOME_COUNTRY.
ONSITE_REGIONS=""
# Hybrid jobs also in these countries (HOME_COUNTRY is always included).
HYBRID_COUNTRIES=""
# A job breaking those rules in one of these countries still passes when the
# scorer's annual pay estimate reaches the bar: worth moving for. The scorer
# converts its estimate to SALARY_CURRENCY (an ISO code: EUR, CHF, GBP, USD...;
# default EUR), and the bar is in that currency.
RELOCATION_COUNTRIES=""
SALARY_CURRENCY="EUR"
RELOCATION_MIN_SALARY=150000
# Points off a job that passes but means moving, so it ranks below an equal
# fit nearer home: RELOCATION_PENALTY for one outside HOME_COUNTRY (not
# remote); REGION_MOVE_PENALTY for an on-site or hybrid one in HOME_COUNTRY
# outside HOME_REGIONS. 0 = none. For jobs scored before this:
# python evaluate.py --move-penalty
RELOCATION_PENALTY=0
HOME_REGIONS=""
REGION_MOVE_PENALTY=0

# A mail label (folder) where you file employers' decline emails; each night
# they are matched to an application and moved to Declined with the reason.
# Empty = off. The first run looks this many days back.
DECLINE_FOLDER=""
DECLINE_LOOKBACK_DAYS=90
# One firm under two names ("long name=short name", comma-separated), so its
# adverts on two boards are recognised as duplicates.
COMPANY_ALIASES=""
# Queued links (python link_queue.py add ...) read per night.
LINK_FETCH_MAX_PER_RUN=60

# Jobs at or above this but below the bar are still listed in the summary email
# under "Worth a look".
NEAR_MISS_SCORE=6

# Rejected jobs older than this drop off the board. The rows stay in the
# database, so the scraper still knows it has seen them and will not re-add them.
REJECTED_BOARD_DAYS=7

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------
# These are a fallback. The real search lives in CVS_DIR/search_criteria.md,
# which the dashboard's "Search Settings" button edits. A keyword line may pin
# its own locations: "- Interim Manager @ Switzerland / France".
SEARCH_KEYWORDS="Software Engineer, Backend Developer"
SEARCH_LOCATIONS="New York, Remote"
# Maps onto LinkedIn's f_JT filter: Full-time, Part-time, Contract, Temporary,
# Internship, Volunteer, Other.
SEARCH_JOB_TYPES="Contract, Part-time, Temporary"
# Result pages (25 jobs each) the scraper reads per keyword and location. Each
# page is one more search on your own LinkedIn account.
LINKEDIN_SEARCH_PAGES=1

# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------
# Everything personal lives here, never in the repo: CV and cover letter
# templates, the career dossier, search_criteria.md, rules.md, profile.yaml,
# ats_accounts.yaml and the generated applications.
CVS_DIR="cvs"
CV_TEMPLATE_NAME="Base_CV_Template.docx"
CL_TEMPLATE_NAME="Base_CL_Template.docx"
DOSSIER_NAME="Career_Dossier.md"
CANDIDATE_NAME="Jane Doe"

# Sender city on cover letters, and how it is written in a letter in another
# language: HOME_CITY_<code> - FR, DE, IT, ES, NL, PT... (locales.LANGUAGE_CODES).
HOME_CITY="City, Country"
HOME_CITY_FR="City, Pays"
# How long a generated CV may run: "norms" (default) = the job's regional norm
# (cv_norms.py: 2 pages in the UK, 1-2 in DACH...), never more than the
# template; "template" = the template's own length.
CV_PAGE_LIMIT="norms"
# The dialling code for a phone number in profile.yaml written without one
# (e.g. 41, 49, 1); empty = the number's own, else HOME_COUNTRY's.
PHONE_COUNTRY_CODE=""

# ---------------------------------------------------------------------------
# DOCX -> PDF conversion
# ---------------------------------------------------------------------------
SOFFICE_PATH="/Applications/LibreOffice.app/Contents/MacOS/soffice"
# LibreOffice's headless backend on macOS resolves fonts through fontconfig,
# which cannot see the system fonts, so it silently substitutes every one of
# them - Verdana has no metric-compatible clone and falls back to a serif.
# Defaults to "osx" on macOS, which fixes it. Leave empty on Linux, where the
# default backend is correct (install ttf-mscorefonts-installer there instead).
SOFFICE_VCLPLUGIN=""

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
DASHBOARD_PORT=5050
# Base URL for links in emails and notifications. localhost only works on the
# machine that sent them - use the host's LAN or Tailscale name so a link opens
# from a phone.
DASHBOARD_URL="http://localhost:5050"
# Optional second address, linked next to the first in every email - e.g. the
# machine's Tailscale address, for opening the dashboard away from home.
DASHBOARD_REMOTE_URL=""
# Opt-in: Flask's reloader spawns a second process that fights for the port.
FLASK_DEBUG=""

# ---------------------------------------------------------------------------
# Applier
# ---------------------------------------------------------------------------
# Multiplier on every wait between interactions, which are jittered around
# their nominal value. Raise to slow the whole run down (2.0 = twice as slow).
APPLY_PACE="1.0"

# Filled forms are left open for review. The countdown only runs while they sit
# untouched - typing or navigating in them resets it - and "Close forms" on the
# dashboard ends the wait immediately.
APPLY_REVIEW_IDLE_MINUTES="120"

# 0 keeps every filled form open. A closed form is a lost one, since nothing
# persists its values, so cap this only on a host that shares its memory:
# each tab costs roughly 150MB of Chromium.
APPLY_MAX_OPEN_TABS=0

# A batch aborts below this much free RAM, so a runaway run cannot take other
# services on the host down with it. Linux only - macOS reports no figure.
APPLY_MIN_FREE_MB=400

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Sent for the nightly run and for batch application runs. A single-job Fill or
# Apply reports on the dashboard only - one mail per form buries the summaries
# that are worth reading.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="your-email@example.com"
SMTP_TO="your-email@example.com"
