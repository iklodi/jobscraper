# ---------------------------------------------------------------------------
# Mode - read DISCLAIMER.md
# ---------------------------------------------------------------------------
# full: scrapes and applies through a browser signed in to your LinkedIn
#       account. LinkedIn prohibits this; the account can be restricted or banned.
# safe: never automates your logged-in account. New jobs come from the job-alert
#       emails LinkedIn sends you (IMAP settings below). Anything that is not a
#       recognised value is treated as safe.
JOBSCRAPER_MODE="full"

# Safe mode reads LinkedIn job-alert emails from this mailbox, read-only: mail
# is never marked, moved or deleted. Use an app password, not your real one.
IMAP_HOST="imap.gmail.com"
IMAP_USER="you@example.com"
IMAP_PASSWORD=""
IMAP_FOLDER="INBOX"
# How far back the first run looks; later runs continue from the last email read.
ALERT_LOOKBACK_DAYS=14
# Descriptions are read from public job pages in a throwaway browser with no
# cookies. At most this many per run; a job that fails this many times is
# reported instead of retried. If LinkedIn walls the fetcher, the run stops and
# tries again next time - there is no proxying or evasion.
SAFE_FETCH_MAX_PER_RUN=60
SAFE_FETCH_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Infomaniak AI Services is tried first when configured - Swiss-hosted, and the
# default cascade leads with gemma, which follows the hard rules in rules.md
# more faithfully than the alternatives. Token needs the "ai-tools" scope;
# product id comes from GET https://api.infomaniak.com/1/ai
# Leave INFOMANIAK_MODELS empty to use the cascade in infomaniak.py; run
# "python infomaniak.py" to list the model ids this account can use.
INFOMANIAK_API_TOKEN=""
INFOMANIAK_PRODUCT_ID=""
INFOMANIAK_MODELS=""

# Fallbacks, used only when Infomaniak is unset or every model there fails.
# Any one of the three providers is enough to run.
GEMINI_API_KEY="your-gemini-key-here"
GROQ_API_KEY="your-groq-key-here"

# ---------------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------------
# At or above this score a job lands on the To Do board, and the evaluator is
# asked for salary, recruiter flag, hiring manager and language. Read in one
# place (db.min_pass_score) and injected into the prompt, so the board
# threshold and the prompt cannot drift apart.
MIN_PASS_SCORE=7

# Jobs at or above this but below the bar are still listed in the summary email
# under "Worth a look".
NEAR_MISS_SCORE=6

# Rejected jobs older than this drop off the board. The rows stay in the
# database, so the scraper still knows it has seen them and will not re-add them.
REJECTED_BOARD_DAYS=7

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------
# These are a fallback. The real search lives in CVS_DIR/search_criteria.md,
# which the dashboard's "Search Settings" button edits. A keyword line may pin
# its own locations: "- Interim Manager @ Switzerland / France".
SEARCH_KEYWORDS="Software Engineer, Backend Developer"
SEARCH_LOCATIONS="New York, Remote"
# Maps onto LinkedIn's f_JT filter: Full-time, Part-time, Contract, Temporary,
# Internship, Volunteer, Other.
SEARCH_JOB_TYPES="Contract, Part-time, Temporary"

# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------
# Everything personal lives here, never in the repo: CV and cover letter
# templates, the career dossier, search_criteria.md, rules.md, profile.yaml,
# ats_accounts.yaml and the generated applications.
CVS_DIR="cvs"
CV_TEMPLATE_NAME="Base_CV_Template.docx"
CL_TEMPLATE_NAME="Base_CL_Template.docx"
DOSSIER_NAME="Career_Dossier.md"
CANDIDATE_NAME="Jane Doe"

# Sender city on cover letters, and its French rendering.
HOME_CITY="City, Country"
HOME_CITY_FR="City, Pays"

# ---------------------------------------------------------------------------
# DOCX -> PDF conversion
# ---------------------------------------------------------------------------
SOFFICE_PATH="/Applications/LibreOffice.app/Contents/MacOS/soffice"
# LibreOffice's headless backend on macOS resolves fonts through fontconfig,
# which cannot see the system fonts, so it silently substitutes every one of
# them - Verdana has no metric-compatible clone and falls back to a serif.
# Defaults to "osx" on macOS, which fixes it. Leave empty on Linux, where the
# default backend is correct (install ttf-mscorefonts-installer there instead).
SOFFICE_VCLPLUGIN=""

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
DASHBOARD_PORT=5050
# Base URL for links in emails and notifications. localhost only works on the
# machine that sent them - use the host's LAN or Tailscale name so a link opens
# from a phone.
DASHBOARD_URL="http://localhost:5050"
# Opt-in: Flask's reloader spawns a second process that fights for the port.
FLASK_DEBUG=""

# ---------------------------------------------------------------------------
# Applier
# ---------------------------------------------------------------------------
# Multiplier on every wait between interactions, which are jittered around
# their nominal value. Raise to slow the whole run down (2.0 = twice as slow).
APPLY_PACE="1.0"

# Filled forms are left open for review. The countdown only runs while they sit
# untouched - typing or navigating in them resets it - and "Close forms" on the
# dashboard ends the wait immediately.
APPLY_REVIEW_IDLE_MINUTES="120"

# 0 keeps every filled form open. A closed form is a lost one, since nothing
# persists its values, so cap this only on a host that shares its memory:
# each tab costs roughly 150MB of Chromium.
APPLY_MAX_OPEN_TABS=0

# A batch aborts below this much free RAM, so a runaway run cannot take other
# services on the host down with it. Linux only - macOS reports no figure.
APPLY_MIN_FREE_MB=400

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Sent for the nightly run and for batch application runs. A single-job Fill or
# Apply reports on the dashboard only - one mail per form buries the summaries
# that are worth reading.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="your-email@example.com"
SMTP_TO="your-email@example.com"
