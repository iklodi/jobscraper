<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.jobscraper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/jobscraper/venv/bin/python</string>
        <string>main.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/path/to/jobscraper</string>

    <key>StandardOutPath</key>
    <string>/path/to/jobscraper/cron.log</string>

    <key>StandardErrorPath</key>
    <string>/path/to/jobscraper/cron.log</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- This ensures it wakes the machine up if it's sleeping, or runs immediately upon waking -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
